  "hub_registries": {
    "entities": {
      "description": "Entidades do hub (squads, services, apps, 740 entries)",
      "path": "workspace/businesses/sinkra-hub/registries/entity-registry.json",
      "format": "json",
      "entity_type": "Entity"
    },
    "people": {
      "description": "Founders e stakeholders do hub (7 entries)",
      "path": "workspace/businesses/sinkra-hub/registries/people-registry.json",
      "format": "json",
      "entity_type": "Person"
    },
    "artifacts": {
      "description": "Catálogo de artefatos canônicos com lifecycle e TTL (5 docs)",
      "path": "workspace/businesses/sinkra-hub/registries/artifacts.json",
      "format": "json",
      "entity_type": "Artifact"
    },
    "processes": {
      "description": "Processos SINKRA mapeados hub-generic (10 processos)",
      "path": "workspace/businesses/sinkra-hub/registries/processes.json",
      "format": "json",
      "entity_type": "Process"
    },
    "tokens": {
      "description": "Tokens SINKRA SK-IDs (187 entries)",
      "path": "workspace/businesses/sinkra-hub/registries/tokens.json",
      "format": "json",
      "entity_type": "Token"
    },
    "governance_rules": {
      "description": "Regras de governança e vetos (8 rules + 7 vetos)",
      "path": "workspace/businesses/sinkra-hub/registries/governance-rules.json",
      "format": "json",
      "entity_type": "GovernanceRule"
    }
  },
  "top_level_indexes": {
    "apps": {
      "description": "Deployable applications (8 apps)",
      "path": "apps/INDEX.json",
      "format": "json",
      "entity_type": "App",
      "boundary": "ONLINE"
    },
    "packages": {
      "description": "Shared stateless libraries (9 packages)",
      "path": "packages/INDEX.json",
      "format": "json",
      "entity_type": "Package",
      "boundary": "ONLINE"
    },
    "squads": {
      "description": "Ecosystem de squads registrados (51 squads)",
      "path": "squads/INDEX.json",
      "format": "json",
      "entity_type": "Squad"
    },
    "services": {
      "description": "Service adapters to external systems (11 services)",
      "path": "services/INDEX.json",
      "format": "json",
      "entity_type": "Service",
      "boundary": "ONLINE"
    },
    "infrastructure": {
      "description": "Infrastructure catalog (10 modules)",
      "path": "infrastructure/INDEX.json",
      "format": "json",
      "entity_type": "Infrastructure"
    },
    "infrastructure_map": {
      "description": "Infrastructure map — servers, platforms, deploy_targets, topology (v3.0.0)",
      "path": "infrastructure/infrastructure-map.json",
      "format": "json",
      "entity_type": "InfrastructureMap",
      "boundary": "ONLINE",
      "migrated_from": "squads/infra-ops/data/infrastructure-map.json",
      "migration_story": "Story 146.1"
    }
  },
  "business_registries": {
    "allfluence": {
      "description": "AllFluence business-specific registries",
      "correlation": ".allfluence/ → workspace/businesses/allfluence/",
      "registries": {
        "processes": "workspace/businesses/allfluence/registries/processes.json"
      }
    }
  },
  "config": {
    "description": "Behavioral config (thresholds, resolution order)",
