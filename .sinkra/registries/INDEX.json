{
  "$schema": "sinkra-index-v1",
  "description": "Master INDEX — ponteiros para registries canônicos do Sinkra Hub. NÃO duplica dados (D6).",
  "updated_at": "2026-05-03",
  "version": "2.0.0",
  "migration_from": "v1.0.0 (squads/sinkra-squad/data/*.yaml → workspace + top-level JSON)",
