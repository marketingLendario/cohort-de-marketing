{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinkra-hub/templates/compliance-report-v1.json",
  "title": "Compliance Report v1",
  "description": "Output template para tsk03_validar_compliance_v5. V1-V126 validators + anti-patterns AP-V5-* findings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["validators_results", "anti_patterns_detected", "anti_patterns_clean", "timestamp"],
  "properties": {
    "validators_results": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["PASS", "FAIL", "WARN", "INFO", "SKIP"]
      },
      "description": "Map de validator ID → resultado. Ex: { V116: PASS, V117: PASS, V120: PASS, ... }"
    },
    "anti_patterns_detected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity"],
        "properties": {
          "id": { "type": "string", "pattern": "^AP(-[A-Z0-9]+){1,3}$" },
          "name": { "type": "string" },
          "severity": { "type": "string", "enum": ["VETO", "HALT", "WARN", "INFO"] },
          "axiom_violated": { "type": "string" },
          "location": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "anti_patterns_clean": { "type": "boolean" },
    "halt_findings_count": { "type": "integer", "minimum": 0 },
    "warn_findings_count": { "type": "integer", "minimum": 0 },
    "info_findings_count": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "branch_id": { "type": "string" }
  }
}
